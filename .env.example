# Jev decision routing (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.65
MAX_TURNS=20
PORT=3000
DATA_DIR=.data
# Default working directory offered when binding an agent.
# AGENT_WORKSPACE=/absolute/path/to/your/project
# CODEX_BIN=codex
# PI_BIN=pi
# Both runtimes use their existing local authentication and default model.
