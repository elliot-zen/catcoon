{
  "name": "catcoon-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "session": "node scripts/session.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "test:live": "node scripts/live-test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
